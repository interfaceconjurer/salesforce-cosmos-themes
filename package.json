{
  "name": "salesforce-cosmos-themes",
  "displayName": "Salesforce Cosmos Themes",
  "description": "VSCode color themes based on the Salesforce Lightning Design System Cosmos Theme",
  "version": "0.0.1",
  "publisher": "salesforce",
  "engines": {
    "vscode": "^1.99.3"
  },
  "categories": [
    "Themes"
  ],
